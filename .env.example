# Copy to .env.local and fill in. Never commit .env.local.

# Gemini (Google AI Studio). Tested 2026-10-17: the newest Flash models (3.7, 3.8) were
# overloaded (503s / ~60s replies) and Pro has no quota on a free key, so both tiers use 3.6 Flash
# (smart calls just raise the thinking level). The fallback is used on 429/503.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_SMART_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Tiger Cloud Postgres connection string (with sslmode=require)
DATABASE_URL=

# Browser Use Cloud: mocked until the key arrives (PRD section 13.1)
BROWSER_USE_API_KEY=
BROWSER_USE_MOCK=true

# ElevenLabs: Web Speech stub until the key arrives (PRD section 13.1)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_VOICE_PROVIDER=webspeech

# Deferred Google account linking. MVP saves use an anonymous HttpOnly device cookie.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public base URL and mutation Origin allow-list. Required HTTPS origin in production;
# e.g. https://<vm-ip>.sslip.io until the real domain exists. Match your dev port locally.
APP_URL=http://localhost:3000

# Optional: curl binary used to fetch recipe pages. Defaults to curl (curl.exe on Windows).
CURL_PATH=

# Sentry (DSN is in the sentry.*.config.ts files). Build-time token for source-map upload;
# the wizard stores it in .env.sentry-build-plugin (gitignored). Never commit a value.
SENTRY_AUTH_TOKEN=
